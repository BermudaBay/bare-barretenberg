{
  "name": "@bermuda/bare-barretenberg",
  "version": "0.1.0",
  "description": "Native Noir witness generation and multithreaded barretenberg proving for Bare on iOS and Android",
  "license": "Apache-2.0",
  "addon": true,
  "exports": {
    ".": "./src/index.js",
    "./imports": "./src/imports.json",
    "./worker-threads": "./src/worker-threads.js",
    "./unavailable": "./src/unavailable.js",
    "./package": "./package.json"
  },
  "files": [
    "src",
    "CMakeLists.txt",
    "Cargo.toml",
    "Cargo.lock",
    "prebuilds"
  ],
  "engines": {
    "bare": ">=1.37.0"
  },
  "scripts": {
    "test": "node node_modules/bare-runtime/bin/bare test/index.js"
  },
  "dependencies": {
    "bare-dns": "2.3.2",
    "bare-fs": "4.8.4",
    "bare-https": "4.0.0",
    "bare-path": "3.1.3",
    "bare-worker": "4.5.3"
  },
  "devDependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "bare-make": "2.1.2",
    "bare-node-runtime": "1.5.5",
    "bare-runtime": "1.37.1",
    "brittle": "4.5.0",
    "cmake-bare": "1.14.1"
  }
}
